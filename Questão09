java
public class TesteQuarto {

    public static void main(String[] args) {

        Quarto quarto1 = new Quarto(101, "Simples", 150.00);
        Quarto quarto2 = new Quarto(202, "Suíte", 350.00);

        System.out.println("=== QUARTO 1 ===");
        System.out.println("Número: " + quarto1.getNumero());
        System.out.println("Tipo: " + quarto1.getTipo());
        System.out.println("Preço por noite: R$ " + quarto1.getPrecoPorNoite());
        System.out.println("Ocupado: " + quarto1.isEstaOcupado());

        quarto1.reservar();

        System.out.println("Ocupado após reserva: " + quarto1.isEstaOcupado());

        System.out.println("Valor para 3 dias: R$ " + quarto1.calcularValor(3));

        quarto1.liberar();

        System.out.println("Ocupado após liberar: " + quarto1.isEstaOcupado());

        System.out.println("\n=== QUARTO 2 ===");
        System.out.println("Número: " + quarto2.getNumero());
        System.out.println("Tipo: " + quarto2.getTipo());
        System.out.println("Preço por noite: R$ " + quarto2.getPrecoPorNoite());

        quarto2.reservar();

        System.out.println("Valor para 5 dias: R$ " + quarto2.calcularValor(5));
    }
}
