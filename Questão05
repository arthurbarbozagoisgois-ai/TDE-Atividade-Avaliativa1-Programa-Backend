Parte01-Tempo.java
public class Tempo {

    private int horas;
    private int minutos;
    private int segundos;

    // Construtor que inicializa os atributos da classe
    public Tempo(int horas, int minutos, int segundos) {
        this.horas = horas;
        this.minutos = minutos;
        this.segundos = segundos;
    }

    public int getHoras() {
        return horas;
    }

    public void setHoras(int horas) {
        this.horas = horas;
    }

    public int getMinutos() {
        return minutos;
    }

    public void setMinutos(int minutos) {
        this.minutos = minutos;
    }

    public int getSegundos() {
        return segundos;
    }

    public void setSegundos(int segundos) {
        this.segundos = segundos;
    }

    public void imprimirTempo() {
        System.out.printf("%02d:%02d:%02d%n", horas, minutos, segundos);
    }

    // Calcula a quantidade total de minutos do objeto Tempo
    public int calcularMinutos() {
        return (horas * 60) + minutos;
    }

    // Calcula a quantidade total de segundos do objeto Tempo
    public int calcularSegundos() {
        return (horas * 3600) + (minutos * 60) + segundos;
    }
}
//Parte02-TesteTempo.java
public class TesteTempo {

    public static void main(String[] args) {

        Tempo tempo = new Tempo(2, 30, 45);
        Tempo tempo2 = new Tempo(0, 45, 10);

        tempo.imprimirTempo();
        tempo2.imprimirTempo();

        System.out.println("Horas: " + tempo.getHoras());
        System.out.println("Minutos: " + tempo.getMinutos());
        System.out.println("Segundos: " + tempo.getSegundos());

        // Os setters alteram só o objeto chamado
        tempo2.setHoras(1);
        tempo2.imprimirTempo();

        System.out.println("Total de minutos: " + tempo.calcularMinutos());
        System.out.println("Total de segundos: " + tempo.calcularSegundos());
    }
}
